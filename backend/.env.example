# ==============================================================================
# DataNova AI — Backend Environment Configuration
# ==============================================================================
# Copy this file to `backend/.env` (or set these as environment variables on your host).
# NEVER commit your actual `.env` file containing real secret keys to source control.
# ==============================================================================

# LLM Provider API Key (Groq Cloud)
# Obtain your free API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Secret Key for Session Authentication
# In production, generate a secure 64-character random secret:
# In bash/zsh: openssl rand -hex 32
# In Python:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# JWT Token Expiration Time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated URLs without trailing slashes)
# Set this to your frontend URL in production (e.g. https://datanova.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection URL
# SQLite default (local file): leave empty or use sqlite:///datanova.db
# Persistent volume mount:    sqlite:////data/datanova.db
# Managed PostgreSQL:        postgresql://user:password@host:5432/datanova
DATABASE_URL=

# Environment Mode (development | production)
ENVIRONMENT=development

# Persistent Data Storage Directory (optional)
# When set, SQLite database, uploads, charts, and reports are stored here.
# Recommended for persistent volume mounts on Render, Railway, Fly.io, or Docker.
# Example: DATA_DIR=/data
DATA_DIR=

# Server Port (optional; cloud providers like Render/Railway pass PORT automatically)
PORT=8000
